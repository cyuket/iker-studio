            "minDurationSeconds": 0
          },
          "captions": {
            "enabled": true
          },
          "audio": {
            "narrationVolume": 1
          },
          "chapterTitle": "You stay in charge",
          "assets": []
        },
        {
          "id": "outcome",
          "type": "OUTCOME",
          "enabled": true,
          "narration": "So the next time someone writes \"last price, dear?\", you send your booking link. Everyone sees the same price and what it includes, and any discount is one you planned. You answer with a link, not a negotiation.",
          "estimatedDurationSeconds": 16.1,
          "visualInstructions": "Back to the DM: a new \"Last price, dear?\" and the reply is the booking link. No promises about bookings or income.",
          "visual": {
            "kind": "statement",
            "headline": "What changes for the business",
            "points": [],
            "tone": "neutral"
          },
          "animation": {
            "enter": "rise",
