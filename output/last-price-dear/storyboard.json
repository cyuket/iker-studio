          },
          "chapterTitle": "Recording a payment",
          "assets": []
        },
        {
          "id": "confirm",
          "type": "EXPLANATION",
          "enabled": true,
          "narration": "Discounts are still yours to give. Depending on your plan, Sales and discounts creates a promotion with its own link and a percentage off the services you choose. Only people with that link get the offer, and the discount is recorded in your books.",
          "estimatedDurationSeconds": 18.5,
          "visualInstructions": "Sales & discounts: a promotion with its own link and a percentage off chosen services. Caption: \"Depending on your plan\".",
          "visual": {
            "kind": "steps",
