          },
          "chapterTitle": "What changes",
          "assets": []
        },
        {
          "id": "cta",
          "type": "CTA",
          "enabled": true,
          "narration": "Want the Iker team to set up your Rate card and booking link with you? Go to useiker.com and tap Get started. Get booked. Get paid.",
          "estimatedDurationSeconds": 11.3,
          "visualInstructions": "useiker.com and \"Get started\". Tagline.",
