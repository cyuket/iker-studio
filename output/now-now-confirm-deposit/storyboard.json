        {
          "id": "maybe-booked",
          "type": "EXPLANATION",
          "enabled": true,
          "narration": "Here is the difference. A date with no deposit is a maybe. A date with proof is a booking. Proof of payment does not make anyone pay faster. It gives you something real to check before you confirm the slot.",
          "estimatedDurationSeconds": 16.9,
          "visualInstructions": "comparison. Left: a date with no deposit behind it, \"maybe\". Right: a date with proof behind it, \"booked\".",
          "visual": {
            "kind": "comparison",
            "heading": "Maybe or booked",
            "left": {
              "title": "No deposit behind it",
              "points": [
                "Saturday 10:30",
                "A maybe"
              ],
              "tone": "warning"
            },
            "right": {
              "title": "Proof behind it",
              "points": [
                "Saturday 10:30",
                "A booking"
              ],
              "tone": "positive"
            }
          },
          "direction": {
            "objective": "One idea: a date is only a booking when there is proof behind it.",
            "representation": "Same date twice: maybe on the left, booked on the right.",
            "finalFrame": "Both columns visible, booked side in the accent."
          },
          "animation": {
            "enter": "rise",
            "leadInSeconds": 0.4,
            "tailSeconds": 0.5,
            "minDurationSeconds": 0
          },
          "captions": {
