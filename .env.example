# Iker Video Studio environment.
# Copy to .env (`pnpm studio init` does this) and fill in only what you need.
# Each integration is validated the first time it is used, so everything below the
# "Application" block is optional until you run a command that needs it.
# Never commit .env. Values here are never printed or logged by the studio.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# development | test | production
NODE_ENV=development

# Demo environment for recording the real product. Iker has no Sandbox mode, so use a
# local copy of the web app (slot-books, with demo data) or a staging host that holds demo
# data only. The recorder always refuses useiker.com and every subdomain of it, and refuses
# plain http except on localhost and 127.0.0.1.
# Examples: http://localhost:3000   https://staging.iker.example
IKER_DEMO_BASE_URL=
# How the recorder gets a signed-in session:
#   password  signs in with the username and password below (no two-factor account).
#   session   reuses a session you create with `pnpm studio demo-login`. Use this for
#             accounts that do not sign in with a password: you sign in yourself.
IKER_DEMO_AUTH=
IKER_DEMO_USERNAME=
IKER_DEMO_PASSWORD=
# Optional: extra hostnames the recorder must refuse, comma separated.
IKER_PRODUCTION_HOSTS=

# ---------------------------------------------------------------------------
# ElevenLabs (production narration; paid, billed per character)
# ---------------------------------------------------------------------------
ELEVENLABS_API_KEY=
# Voice to use. Choose a calm, clear English voice; British English voices work.
ELEVENLABS_VOICE_ID=
# Defaults to eleven_multilingual_v2 when empty.
ELEVENLABS_MODEL_ID=
# Optional MP3 quality. Empty means mp3_44100_128, which every plan allows.
# mp3_44100_192 needs the Creator tier or above.
ELEVENLABS_OUTPUT_FORMAT=
# Optional: your plan's price in USD per 1,000 credits. Only used to show money
# estimates in `pnpm studio costs`; without it, costs are shown in credits.
ELEVENLABS_USD_PER_1K_CREDITS=

# ---------------------------------------------------------------------------
# Cloudflare R2 (optional private storage for exports and shared assets)
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional: `pnpm studio storage prune` deletes exports older than this many days.
R2_RETENTION_DAYS=

# ---------------------------------------------------------------------------
# Rendering
# ---------------------------------------------------------------------------
# Browser tabs used while rendering. Empty lets Remotion choose (half the CPU threads).
RENDER_CONCURRENCY=
# 24 | 25 | 30 | 60. Empty means 30.
DEFAULT_FPS=30
# 720p | 1080p | 1440p | 2160p. Applies to final renders; previews are always half size.
DEFAULT_RESOLUTION=2160p
# Where videos and their generated files live, relative to the project root.
OUTPUT_DIRECTORY=output
# Remotion company licence key, if your organisation needs one. See docs/LICENSING.md.
REMOTION_LICENSE_KEY=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
# pretty | json
LOG_FORMAT=pretty

# ---------------------------------------------------------------------------
# Optional publishing (YouTube Data API v3)
# ---------------------------------------------------------------------------
# OAuth client of type "Desktop app". Credentials alone do not enable publishing.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Must be exactly "true" before `pnpm studio publish` will upload anything.
YOUTUBE_PUBLISHING_ENABLED=false
