          },
          "chapterTitle": "On the booking",
          "assets": []
        },
        {
          "id": "payment",
          "type": "DEMO",
          "enabled": true,
          "narration": "If you take a deposit, it is set on the service as a percentage of the price, so the client sees it while booking. They transfer straight to your account and upload proof of payment. Iker records it but never holds the money.",
          "estimatedDurationSeconds": 18.1,
          "visualInstructions": "The slot step's header with the deposit and total split, then the payment details and proof of payment upload.",
          "visual": {
            "kind": "product",
            "scenarioId": "synthetic-record-payment",
            "mode": "video",
            "device": "browser",
            "annotations": [],
