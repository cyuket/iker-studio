        {
          "id": "booking",
          "type": "DEMO",
          "enabled": true,
          "narration": "Clients see it on your booking link, the page you put in your Instagram bio or WhatsApp status. Every service shows its price, and they can sort by price. Then they pick a time that is really open. The question changes from \"how much?\" to \"which slot?\"",
          "estimatedDurationSeconds": 19.7,
          "visualInstructions": "The public booking page on a phone: services with prices, then \"Sort by price\", then the slot picker with open times only.",
          "visual": {
            "kind": "product",
            "scenarioId": "synthetic-new-booking",
            "mode": "video",
            "device": "browser",
            "annotations": [],
